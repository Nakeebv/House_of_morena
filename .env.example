# This example file was sanitized to remove any real secrets.
# Do NOT commit actual secrets into the repository.
# If you need an example, recreate with non-sensitive placeholder values.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/app_db

# Password for the store admin panel at /admin
# Choose a long, private password for /admin — never commit the real one
ADMIN_PASSWORD=changeme

# Secret used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-in-production

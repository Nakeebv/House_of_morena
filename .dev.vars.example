# Local secrets for `npx wrangler dev`.
# Copy to .dev.vars — that file is gitignored.

DATABASE_URL=postgresql://user:password@host:5432/morena
ADMIN_PASSWORD=choose-a-long-private-password
ADMIN_SESSION_SECRET=change-me

# Email (optional — messages queue until these are set)
RESEND_API_KEY=
EMAIL_FROM=Morena Collection <orders@yourdomain.com>
SELLER_EMAIL=
